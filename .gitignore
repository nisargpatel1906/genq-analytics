# ==============================================================================
# GenQ Analytics — Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL: Never commit credentials)
# ------------------------------------------------------------------------------
.env
.env*
.env.*
.env.local
.env.*.local
**/.env
**/.env*
**/.env.*
**/.env.local
**/.env.*.local
*.local
**/*.local

# Preserve example environment templates
!.env.example
!**/.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 2. SQLite Databases & State Files (CRITICAL: Never commit database files)
# ------------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
backend/*.db*
backend/reports.db*
backend/reports_test.db*
backend/reports_split_test.db*
backend/reports_store.json

# ------------------------------------------------------------------------------
# 3. Generated Visualizations, Exports & Data Caches
# ------------------------------------------------------------------------------
*.pdf
*.docx
*.png
*.jpg
*.jpeg
*.svg
!frontend/src/assets/**
!frontend/public/**
!frontend/public/logo/**
!frontend/src/assets/logo/**
backend/*.png
backend/*.pdf
backend/*.docx
backend/data/
backend/data/images/
backend/data/samples/
backend/tests/data/
backend/scratch/
scratch/

# User data, uploaded files & test datasets (Keep dataset generator script)
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
test_datasets/*.csv
!test_datasets/generate_datasets.py

# ------------------------------------------------------------------------------
# 4. Logs
# ------------------------------------------------------------------------------
*.log
**/*.log
backend/genq_analytics.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Python Runtime & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
venv/
.venv/
env/
ENV/
backend/venv/
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 6. Frontend / Node / Vite Runtime & Builds
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
frontend/node_modules/
dist/
**/dist/
frontend/dist/
frontend/.npm/
dist-ssr/
.vite/
**/.vite/

# ------------------------------------------------------------------------------
# 7. IDE, OS & Antigravity Metadata
# ------------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.antigravityrules
.docs
!.docx/
!.docx/**
graphify-out/
test_datasets/
test_results/
reports_output/
