# ==============================================================================
# GenQ Analytics — Backend Environment Configuration Template
# Copy this file to `backend/.env` and insert your actual API keys.
# DO NOT COMMIT `.env` TO GIT!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary AI Provider Configuration
# Supported: 'openrouter', 'nvidia', 'gemini', 'groq', 'ollama'
# ------------------------------------------------------------------------------
LLM_PROVIDER=openrouter
LLM_MODE=agentic
LLM_FALLBACK_PROVIDER=

# ------------------------------------------------------------------------------
# 2. OpenRouter Configuration (Recommended default / free tier)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional fallback key for automatic seamless rotation if 429 rate limit is hit:
OPENROUTER_FALLBACK_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=GenQ Analytics

# ------------------------------------------------------------------------------
# 3. NVIDIA NIM Configuration (Alternative / Fallback)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_DOMAIN_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
LLM_ANALYSIS_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
LLM_VISUAL_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
LLM_REPORT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
LLM_REVIEW_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
LLM_CHAT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# ------------------------------------------------------------------------------
# 4. Other Providers (Groq / Gemini / Ollama)
# ------------------------------------------------------------------------------
# GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=gemma4:12b

# ------------------------------------------------------------------------------
# 5. Agent & Execution Settings
# ------------------------------------------------------------------------------
LLM_MAX_REGENERATION_ROUNDS=3
LLM_NARRATIVE_STITCHER=true
LLM_TIMEOUT=600
LLM_TEMPERATURE=0.2
MAX_AGENT_LOOPS=6
LLM_STEP_DELAY=3.0
LLM_MAX_CTX_CHARS=16000
LLM_CTX_TAIL_MESSAGES=4
CODE_EXEC_TIMEOUT=90
CODE_REPAIR_MAX_ATTEMPTS=3
SAMPLE_MAX_ROWS=10000

# ------------------------------------------------------------------------------
# 6. File & Analysis Limits
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=500
ANALYSIS_TIMEOUT_SECONDS=180
FILE_RETENTION_HOURS=24

# ------------------------------------------------------------------------------
# 7. Database & Caching
# ------------------------------------------------------------------------------
# Optional SQLite path override (defaults to backend/reports.db)
# DATABASE_PATH=
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 8. Security, CORS & Authentication
# ------------------------------------------------------------------------------
# Leave blank for open local dev. When set, requests must pass 'X-API-Key: <key>'
GENQ_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
